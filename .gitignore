# pipeline outputs never enter git (root-anchored: web/data is handled below)
/data/
spark-warehouse/
metastore_db/
derby.log

# environments and secrets
.venv/
.env
*.pem
*.key
kubeconfig*

# local-only context: never publish. CLAUDE.md IS tracked (it is useful
# engineering documentation); CLAUDE.local.md is not.
CLAUDE.local.md

# terraform: state and any file that could carry the account id or bucket name.
# A saved plan file is state -- it holds every resource attribute in cleartext,
# and `terraform plan -out` is the easy way to leave one lying in the tree.
# The negation must come LAST or git re-ignores the example.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
.terraform.tfstate.lock.info
*.tfvars
*.tfvars.json
tfplan
*.tfplan
crash.log
crash.*.log
!*.tfvars.example

# build/runtime junk
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# large binaries. Tiles under web/ are the deliberate exception, but keep them
# under ~90 MB: git hard-blocks single files at 100 MiB and a stray GeoTIFF in
# history cannot be removed without a rewrite.
*.tif
*.tiff
*.zip
*.parquet
*.gpkg
!web/*.pmtiles.png
# The tiles ship in the repo ON PURPOSE: GitHub Pages serves the interactive
# map from them with zero infrastructure, and the public map has to keep
# working after the cluster is deleted. The committed rf.pmtiles is STATE
# scope, 22.7 MB, rebuilt by `make tiles SCOPE=state`.
web/data/*
# ⚠️ THE `.png` SUFFIX IS LOAD-BEARING AND THE FILES ARE NOT IMAGES.
# GitHub Pages sets Content-Type from the extension, and it gzips
# application/octet-stream -- then answers a byte RANGE against the COMPRESSED
# stream. Measured: a 207,200-byte probe came back as `content-range:
# bytes 0-1023/555`. Every offset in a PMTiles archive or the footprint index
# is an offset into the UNCOMPRESSED file, so the whole serving model breaks,
# and it breaks INTERMITTENTLY because `vary: Accept-Encoding` means curl (no
# Accept-Encoding) gets a correct 206 while every real browser gets the
# compressed one. Probed across extensions: .pmtiles/.bin/.dat/.wasm are
# gzipped; .png/.gz/.woff2/.mp4/.webp are served identity. Pages does not let
# you set headers, so the extension is the only control available.
!web/data/rf.pmtiles.png
!web/data/rsrp_surface_*.png
!web/data/surface_meta.json
# The client reads meta.json for its caption AND its opening viewport, so
# ignoring it shipped a statewide map that opened zoomed into one county.
!web/data/meta.json
# 13 KB gazetteer behind the search box. Committed because it IS the geocoder:
# without it the box silently finds nothing.
!web/data/places.json
# Per-transmitter footprints: 14.6 MB read in ~4 KB Range slices, one per
# clicked structure. Same deliberate exception as rf.pmtiles -- it is the data
# the page serves, and there is no server here to serve it from.
!web/data/footprints.bin.png
!web/data/footprints.json
